{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirromere",
  "version": "0.1.0",
  "identifier": "dev.arda.mirromere",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mirromere",
        "width": 960,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "../../arda-hud/src-tauri/icons/icon.png"
    ]
  }
}
