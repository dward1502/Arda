# Calendar adapter configuration for personal-ops reminders.
# Schema version tracks the config shape; adapters read this at startup.
schema_version = "arda.personal-ops.calendar.v1"
adapter = "ics"
# IANA timezone for local-scheduling interpretation (e.g. "America/New_York").
timezone = "UTC"

# --- CalDAV adapter (only used when adapter = "caldav") ---
# Secret references only — never inline credentials.
caldav_url = ""
caldav_username_ref = "secret://caldev/username"
caldav_password_ref = "secret://caldev/password"
calendar_id = "personal"
