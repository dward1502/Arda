# sigil: SCROLL
# Annunimas canonical environment profile example.
# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/annunimas/annunimas.env for user services,
# or source it from a shell after replacing placeholders with local values.
# Do not store secrets in git-tracked copies of this file.

# -----------------------------------------------------------------------------
# Identity and root paths
# -----------------------------------------------------------------------------
# ANNUNIMAS_USER is a logical operator/profile name, not a path component.
ANNUNIMAS_USER=${USER}
ANNUNIMAS_PROFILE=local
ANNUNIMAS_MACHINE_ROLE=workstation

# Prefer an explicit repo root. When unset, commands should fall back to
# git rev-parse --show-toplevel or the current working directory as appropriate.
ANNUNIMAS_ROOT=${HOME}/Annunimas

# Portable XDG-style locations. Avoid /home/$USER and /var/home/$USER patterns.
ANNUNIMAS_HOME=${HOME}/.local/share/annunimas
ANNUNIMAS_CONFIG_DIR=${XDG_CONFIG_HOME:-${HOME}/.config}/annunimas
ANNUNIMAS_DATA_DIR=${XDG_DATA_HOME:-${HOME}/.local/share}/annunimas
ANNUNIMAS_CACHE_DIR=${XDG_CACHE_HOME:-${HOME}/.cache}/annunimas
ANNUNIMAS_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/annunimas

# Build cache root used by scripts/runtime_build_env.sh.
ANNUNIMAS_BUILD_CACHE_ROOT=${XDG_CACHE_HOME:-${HOME}/.cache}/annunimas-build

# Canonical queue paths. The project task queue is the operational ledger.
ANNUNIMAS_TASK_QUEUE_PATH=core/projects/tasks/queue.jsonl
ANNUNIMAS_PROJECT_TASK_QUEUE_PATH=core/projects/tasks/queue.jsonl
ANNUNIMAS_DAILY_QUEUE_PATH=core/queue/queue.jsonl
ANNUNIMAS_WARDEN_QUEUE_PATH=data/warden/informant_queue.jsonl

# -----------------------------------------------------------------------------
# Agent-local homes and sockets
# -----------------------------------------------------------------------------
ANNUNIMAS_ATHENA_HOME=${ANNUNIMAS_HOME}/athena
ANNUNIMAS_PROMETHEUS_HOME=${ANNUNIMAS_HOME}/prometheus
ANNUNIMAS_CHARON_HOME=${ANNUNIMAS_HOME}/charon
ANNUNIMAS_HADES_HOME=${ANNUNIMAS_HOME}/hades
ANNUNIMAS_HERMES_HOME=${ANNUNIMAS_HOME}/hermes
ANNUNIMAS_MNEMOSYNE_HOME=${ANNUNIMAS_HOME}/mnemosyne

ANNUNIMAS_RUNTIME_SOCKET_DIR=${ANNUNIMAS_RUNTIME_DIR}
ANNUNIMAS_ATHENA_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/athena.sock
ANNUNIMAS_PROMETHEUS_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/prometheus.sock
ANNUNIMAS_CHARON_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/charon.sock
ANNUNIMAS_HADES_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/hades.sock
ANNUNIMAS_HERMES_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/hermes.sock
ANNUNIMAS_MNEMOSYNE_SOCKET=${ANNUNIMAS_RUNTIME_DIR}/mnemosyne.sock

# -----------------------------------------------------------------------------
# Local service endpoints
# -----------------------------------------------------------------------------
# Base URLs are operator-configured. Loopback defaults are safe for single-node
# local development; multi-node/fleet deployments should use DNS, Tailscale, or
# service registry values supplied by the operator.
CHARON_BASE_URL=http://127.0.0.1:5110
HERMES_BASE_URL=http://127.0.0.1:5102
ARDA_HUD_URL=http://127.0.0.1:1420
LOCAL_MODEL_BASE_URL=http://127.0.0.1:9337/v1
LOCAL_MODEL_DEFAULT=
LITELLM_PROXY_URL=http://127.0.0.1:4000/v1

# ATHENA/search helper endpoints. Override per machine when these services are
# hosted remotely or behind a local container network.
ANNUNIMAS_CRAWL4AI_URL=http://127.0.0.1:11235
ANNUNIMAS_SEARCH_RUNTIME_URL=http://127.0.0.1:18080
ANNUNIMAS_SEARCH_RUNTIME_HOST=127.0.0.1
ANNUNIMAS_SEARCH_RUNTIME_PORT=18080
ANNUNIMAS_SEARCH_RUNTIME_IMAGE=docker.io/searxng/searxng:latest
ANNUNIMAS_SEARCH_RUNTIME_CONTAINER_NAME=annunimas-searxng
ANNUNIMAS_PLAYWRIGHT_MCP_CMD="npx @playwright/mcp@latest --stdio"

# -----------------------------------------------------------------------------
# Systemd user units
# -----------------------------------------------------------------------------
# Preferred unit pattern:
#   EnvironmentFile=%h/.config/annunimas/annunimas.env
#   WorkingDirectory=${ANNUNIMAS_ROOT}
# System-level units should not hardcode User= or /home/<name> paths in tracked
# examples; deploy-time units can bind to a concrete account outside git.

# -----------------------------------------------------------------------------
# Provider credentials and comms integrations
# -----------------------------------------------------------------------------
# Keep real values in an untracked operator env file or secret manager.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LITELLM_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_BOARDROOM=
DISCORD_CHANNEL_OPS_BOARDROOM=
DISCORD_CHANNEL_CEO_BOARDROOM=
DISCORD_CHANNEL_CLIENT_BRIDGE=
DISCORD_CHANNEL_RESEARCH_FORGE=
DISCORD_CHANNEL_GOVERNANCE_AUDIT=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#hermes

# -----------------------------------------------------------------------------
# Autonomy and runtime posture
# -----------------------------------------------------------------------------
ANNUNIMAS_AUTONOMY_POSTURE=read_only
ANNUNIMAS_MUTATION_REQUIRES_HUMAN_GATE=true
ANNUNIMAS_SUPERVISOR_AGENT_ORDER=prometheus,charon,hermes,hades,athena,mnemosyne
ANNUNIMAS_SUPERVISOR_MAX_STARTS_PER_PASS=1
ANNUNIMAS_SUPERVISOR_START_STAGGER_MS=750
ANNUNIMAS_SUPERVISOR_PREFLIGHT_REQUIRED=true
ANNUNIMAS_BACKGROUND_SIGNAL_MAX_CONCURRENCY=4
ANNUNIMAS_LOCAL_INFERENCE_SURFACE=mesh
ANNUNIMAS_LOCAL_MODEL=
