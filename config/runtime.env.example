# sigil: SCROLL
# Runtime surface for paths, sockets, and fallback model.
# Copy keys into your shell profile or service manager environment.

# Homes
ANNUNIMAS_ROOT=
ANNUNIMAS_NUMENOR_ROOT=
ANNUNIMAS_VALINOR_ROOT=
ANNUNIMAS_ATHENA_HOME=~/.athena
ANNUNIMAS_PROMETHEUS_HOME=~/.prometheus
ANNUNIMAS_CHARON_HOME=~/.charon
ANNUNIMAS_HADES_HOME=~/.hades
ANNUNIMAS_HERMES_HOME=~/.hermes
ANNUNIMAS_MNEMOSYNE_HOME=~/.mnemosyne

# Sockets
ANNUNIMAS_RUNTIME_SOCKET_DIR=${XDG_RUNTIME_DIR}/annunimas
ANNUNIMAS_ATHENA_SOCKET=${XDG_RUNTIME_DIR}/annunimas/athena.sock
ANNUNIMAS_PROMETHEUS_SOCKET=${XDG_RUNTIME_DIR}/annunimas/prometheus.sock
ANNUNIMAS_CHARON_SOCKET=${XDG_RUNTIME_DIR}/annunimas/charon.sock
ANNUNIMAS_HADES_SOCKET=${XDG_RUNTIME_DIR}/annunimas/hades.sock
ANNUNIMAS_HERMES_SOCKET=${XDG_RUNTIME_DIR}/annunimas/hermes.sock
ANNUNIMAS_MNEMOSYNE_SOCKET=${XDG_RUNTIME_DIR}/annunimas/mnemosyne.sock

# Shared linkage
ANNUNIMAS_WORLD_STATE_PATH=core/state/world.json
ANNUNIMAS_SOTERION_INDEX_PATH=data/soterion_index.json

# Build/runtime cache root.
# Keep Cargo target/tmp churn off tmpfs-backed /tmp.
# The default runtime helper uses ~/.cache/annunimas-build when this is unset.
# Set this only when you want an explicit home-backed or larger mounted cache.
# Prefer a native Linux filesystem for build cache.
# Avoid NTFS/fuseblk game drives for active Rust target/tmp paths unless you accept slower and less reliable metadata behavior.
ANNUNIMAS_BUILD_CACHE_ROOT=${HOME}/.cache/annunimas-build

# Optional archive-only relocation target if you want cold backups off /var.
# Better fit for append-only backup data than for active build/runtime paths.
# ANNUNIMAS_HADES_ARCHIVE_ROOT=/run/media/dward/2CF0AD6CF0AD3CC8/annunimas-data/hades-backups

# Control-plane-first supervisor posture.
# Default order prefers CEO/control-plane lanes before heavier knowledge/memory lanes.
ANNUNIMAS_SUPERVISOR_AGENT_ORDER=prometheus,charon,hermes,hades,athena,mnemosyne
ANNUNIMAS_SUPERVISOR_MAX_STARTS_PER_PASS=1
ANNUNIMAS_SUPERVISOR_START_STAGGER_MS=750
ANNUNIMAS_SUPERVISOR_PREFLIGHT_REQUIRED=true

# Hard cap for detached background Plutus/accounting signals inside ATHENA/HERMES/HADES.
# Keeps bursty async bookkeeping from spawning unbounded thread/runtime work on edge machines.
ANNUNIMAS_BACKGROUND_SIGNAL_MAX_CONCURRENCY=4

# Live-ledger compaction caps for the largest active ATHENA/governance knowledge stores.
# These preserve the latest source identity/event state while trimming append-only duplicate history.
ANNUNIMAS_ATHENA_DIGEST_RECENT_KEEP=512
ANNUNIMAS_ATHENA_DIGEST_MAX_KEEP=4000
ANNUNIMAS_ATHENA_DIGEST_MAX_BYTES=12582912
ANNUNIMAS_RETENTION_DAYS_BACON_LITE=14
ANNUNIMAS_BACON_LITE_MAX_KEEP=12000
ANNUNIMAS_BACON_LITE_MAX_BYTES=16777216
ANNUNIMAS_ATHENA_SOURCES_RECENT_KEEP=256
ANNUNIMAS_ATHENA_SOURCES_MAX_KEEP=2000
ANNUNIMAS_ATHENA_SOURCES_MAX_BYTES=6291456
ANNUNIMAS_WARDEN_INFORMANT_RECENT_KEEP=512
ANNUNIMAS_WARDEN_INFORMANT_MAX_KEEP=6000
ANNUNIMAS_WARDEN_INFORMANT_MAX_BYTES=8388608
ANNUNIMAS_RETENTION_DAYS_WARDEN_PERMISSION_AUDIT=14
ANNUNIMAS_WARDEN_PERMISSION_AUDIT_MAX_KEEP=12000
ANNUNIMAS_WARDEN_PERMISSION_AUDIT_MAX_BYTES=6291456

# Pressure-coupled admission. Shared bounded gates will automatically tighten under
# Joule, disk, memory, and swap pressure using sovereign runtime surfaces.
ANNUNIMAS_PRESSURE_ADMISSION_ENABLED=true
ANNUNIMAS_PRESSURE_ADMISSION_CACHE_MS=1000
ANNUNIMAS_PRESSURE_ADMISSION_DEGRADED_FACTOR=0.5
ANNUNIMAS_PRESSURE_ADMISSION_SEVERE_FACTOR=0.25
ANNUNIMAS_PRESSURE_ADMISSION_MEM_AVAILABLE_DEGRADED_PCT=10
ANNUNIMAS_PRESSURE_ADMISSION_MEM_AVAILABLE_SEVERE_PCT=5
ANNUNIMAS_PRESSURE_ADMISSION_RECEIPTS_PATH=data/prometheus/runtime_admission_shed_receipts.jsonl
ANNUNIMAS_PRESSURE_ADMISSION_RECOVERY_PATH=core/state/runtime_admission_recovery.json

# Heavy runtime work admission caps.
# These bound overlapping ingest, queue draining, outbound retry, and sweep work inside the crates.
ANNUNIMAS_ATHENA_INGEST_MAX_CONCURRENCY=2
ANNUNIMAS_ATHENA_DEEP_QUEUE_MAX_CONCURRENCY=1
ANNUNIMAS_ATHENA_CRAWL_MAX_CONCURRENCY=1
ANNUNIMAS_ATHENA_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_ATHENA_HTTP_MAX_CONCURRENCY=24
ANNUNIMAS_PROMETHEUS_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_PROMETHEUS_HTTP_MAX_CONCURRENCY=24
ANNUNIMAS_CHARON_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_CHARON_HTTP_MAX_CONCURRENCY=24
ANNUNIMAS_HERMES_SEND_MAX_CONCURRENCY=2
ANNUNIMAS_HERMES_POLL_MAX_CONCURRENCY=1
ANNUNIMAS_HERMES_OUTBOUND_RETRY_MAX_CONCURRENCY=1
ANNUNIMAS_HERMES_PROVIDER_DISPATCH_MAX_CONCURRENCY=2
ANNUNIMAS_HERMES_PROVIDER_POLL_MAX_CONCURRENCY=1
ANNUNIMAS_HERMES_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_HERMES_HTTP_MAX_CONCURRENCY=24
ANNUNIMAS_HERMES_DISCORD_ACTIVITY_PANEL=true

# Optional Discord channel alias map. If set, Hermes can route logical recipients
# like boardroom, ops-boardroom, client-bridge, research-forge, and governance-audit
# to distinct Discord channel IDs instead of collapsing all sends to DISCORD_CHANNEL_ID.
# DISCORD_CHANNEL_ID remains the default fallback channel.
# DISCORD_CHANNEL_BOARDROOM=
# DISCORD_CHANNEL_OPS_BOARDROOM=
# DISCORD_CHANNEL_CEO_BOARDROOM=
# DISCORD_CHANNEL_CLIENT_BRIDGE=
# DISCORD_CHANNEL_RESEARCH_FORGE=
# DISCORD_CHANNEL_GOVERNANCE_AUDIT=
ANNUNIMAS_HADES_SWEEP_MAX_CONCURRENCY=1
ANNUNIMAS_HADES_REMOVAL_STEP_MAX_CONCURRENCY=1
ANNUNIMAS_HADES_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_HADES_HTTP_MAX_CONCURRENCY=16
ANNUNIMAS_APOLLO_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_APOLLO_HTTP_MAX_CONCURRENCY=16
ANNUNIMAS_ORACLE_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_ORACLE_HTTP_MAX_CONCURRENCY=16
ANNUNIMAS_PLUTUS_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_PLUTUS_HTTP_MAX_CONCURRENCY=16
ANNUNIMAS_MNEMOSYNE_IPC_MAX_CONCURRENCY=16
ANNUNIMAS_MNEMOSYNE_HTTP_MAX_CONCURRENCY=16

# Launch preflight reads sovereign governance + pressure surfaces before local starts.
# When degraded, only bounded control-plane agents are allowed to spawn by default.
ANNUNIMAS_LAUNCH_PREFLIGHT_DEGRADED_AGENTS=prometheus,charon,hermes
ANNUNIMAS_LAUNCH_PREFLIGHT_ENFORCE_SWAP=true

# Fleet command tower overrides (optional)
ANNUNIMAS_FLEET_CONFIG_PATH=config/fleet.toml
ANNUNIMAS_FLEET_ENABLED=true
ANNUNIMAS_FLEET_STATUS_VIEW_MODE=active_only
ANNUNIMAS_FLEET_STALE_DAYS=14
ANNUNIMAS_FLEET_INCLUDE_RECENT_OFFLINE_IN_STATUS=false
ANNUNIMAS_FLEET_BOOTSTRAP_STATE=core/state/fleet_bootstrap.json
ANNUNIMAS_FLEET_BOOTSTRAP_RECOVER=true
ANNUNIMAS_FLEET_BOOTSTRAP_RECOVER_WAIT_SECONDS=8
ANNUNIMAS_FLEET_BOOTSTRAP_RECOVER_RETRIES=1
ANNUNIMAS_FLEET_BOOTSTRAP_SSH_TIMEOUT_SECONDS=20
ANNUNIMAS_ROUTE_ORIGIN_DEFAULT=auto
ANNUNIMAS_LOCAL_INFERENCE_SURFACE=mesh
ANNUNIMAS_FLEET_PROMETHEUS_DIR=data/prometheus
ANNUNIMAS_FLEET_CEO_LAYER_PROMETHEUS_DIR=core/metrics/by_crate/prometheus
ANNUNIMAS_FLEET_WARDEN_QUEUE_PATH=data/warden/informant_queue.jsonl

# Local fallback model used by CHARON local_fallback provider
ANNUNIMAS_LOCAL_MODEL=qwen2.5-coder:3b
ANNUNIMAS_ATHENA_CRAWL_PROFILE=production
ANNUNIMAS_ATHENA_CRAWL_PROVIDER=crawl4ai,scrapling
ANNUNIMAS_SCRAPLING_RUNTIME_MODE=shim_allowed
LITELLM_PROXY_HOST=127.0.0.1
LITELLM_PROXY_PORT=4000
LITELLM_PROXY_URL=http://${LITELLM_PROXY_HOST}:${LITELLM_PROXY_PORT}/v1
ANNUNIMAS_CRAWL4AI_HOST=127.0.0.1
ANNUNIMAS_CRAWL4AI_PORT=11235
ANNUNIMAS_CRAWL4AI_URL=http://${ANNUNIMAS_CRAWL4AI_HOST}:${ANNUNIMAS_CRAWL4AI_PORT}
ANNUNIMAS_SEARCH_RUNTIME_URL=http://${ANNUNIMAS_SEARCH_RUNTIME_HOST}:${ANNUNIMAS_SEARCH_RUNTIME_PORT}
ANNUNIMAS_SEARCH_RUNTIME_HOST=127.0.0.1
ANNUNIMAS_SEARCH_RUNTIME_PORT=18080
ANNUNIMAS_SEARCH_RUNTIME_IMAGE=docker.io/searxng/searxng:latest
ANNUNIMAS_SEARCH_RUNTIME_CONTAINER_NAME=annunimas-searxng
ANNUNIMAS_PLAYWRIGHT_MCP_CMD="npx @playwright/mcp@latest --stdio"
ANNUNIMAS_NANOCLAW_ROOT=
ANNUNIMAS_NANOCLAW_EDGE_TARGET=node-pi5-warden
ANNUNIMAS_NANOCLAW_EDGE_TRANSPORT=tailscale
ANNUNIMAS_NANOCLAW_CONTROL_MODE=headless

# PROMETHEUS machine thought ledger root
ANNUNIMAS_PROMETHEUS_MINDS=~/.citadel/minds/machine
