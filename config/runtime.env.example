# sigil: SCROLL
# Runtime surface for paths, sockets, and fallback model.
# Copy keys into your shell profile or service manager environment.

# Homes
ARDA_ROOT=
ARDA_NUMENOR_ROOT=
ARDA_VALINOR_ROOT=
ARDA_ATHENA_HOME=~/.athena
ARDA_PROMETHEUS_HOME=~/.prometheus
ARDA_CHARON_HOME=~/.charon
ARDA_HADES_HOME=~/.hades
ARDA_HERMES_HOME=~/.hermes
ARDA_MNEMOSYNE_HOME=~/.mnemosyne

# Sockets
ARDA_RUNTIME_SOCKET_DIR=${XDG_RUNTIME_DIR}/ARDA
ARDA_ATHENA_SOCKET=${XDG_RUNTIME_DIR}/ARDA/athena.sock
ARDA_PROMETHEUS_SOCKET=${XDG_RUNTIME_DIR}/arda/prometheus.sock
ARDA_CHARON_SOCKET=${XDG_RUNTIME_DIR}/arda/charon.sock
ARDA_HADES_SOCKET=${XDG_RUNTIME_DIR}/arda/hades.sock
ARDA_HERMES_SOCKET=${XDG_RUNTIME_DIR}/arda/hermes.sock
ARDA_MNEMOSYNE_SOCKET=${XDG_RUNTIME_DIR}/arda/mnemosyne.sock

# Shared linkage
ARDA_WORLD_STATE_PATH=core/state/world.json
ARDA_SOTERION_INDEX_PATH=data/soterion_index.json

# Build/runtime cache root.
# Keep Cargo target/tmp churn off tmpfs-backed /tmp.
# The default runtime helper uses ~/.cache/arda-build when this is unset.
# Set this only when you want an explicit home-backed or larger mounted cache.
# Prefer a native Linux filesystem for build cache.
# Avoid NTFS/fuseblk game drives for active Rust target/tmp paths unless you accept slower and less reliable metadata behavior.
ARDA_BUILD_CACHE_ROOT=${HOME}/.cache/ARDA-build

# Optional archive-only relocation target if you want cold backups off /var.
# Better fit for append-only backup data than for active build/runtime paths.
# ARDA_HADES_ARCHIVE_ROOT=/run/media/dward/2CF0AD6CF0AD3CC8/ARDA-data/hades-backups

# Control-plane-first supervisor posture.
# Default order prefers CEO/control-plane lanes before heavier knowledge/memory lanes.
ARDA_SUPERVISOR_AGENT_ORDER=prometheus,charon,hermes,hades,athena,mnemosyne
ARDA_SUPERVISOR_MAX_STARTS_PER_PASS=1
ARDA_SUPERVISOR_START_STAGGER_MS=750
ARDA_SUPERVISOR_PREFLIGHT_REQUIRED=true

# Hard cap for detached background Plutus/accounting signals inside ATHENA/HERMES/HADES.
# Keeps bursty async bookkeeping from spawning unbounded thread/runtime work on edge machines.
ARDA_BACKGROUND_SIGNAL_MAX_CONCURRENCY=4

# Live-ledger compaction caps for the largest active ATHENA/governance knowledge stores.
# These preserve the latest source identity/event state while trimming append-only duplicate history.
ARDA_ATHENA_DIGEST_RECENT_KEEP=512
ARDA_ATHENA_DIGEST_MAX_KEEP=4000
ARDA_ATHENA_DIGEST_MAX_BYTES=12582912
ARDA_RETENTION_DAYS_BACON_LITE=14
ARDA_BACON_LITE_MAX_KEEP=12000
ARDA_BACON_LITE_MAX_BYTES=16777216
ARDA_ATHENA_SOURCES_RECENT_KEEP=256
ARDA_ATHENA_SOURCES_MAX_KEEP=2000
ARDA_ATHENA_SOURCES_MAX_BYTES=6291456
ARDA_WARDEN_INFORMANT_RECENT_KEEP=512
ARDA_WARDEN_INFORMANT_MAX_KEEP=6000
ARDA_WARDEN_INFORMANT_MAX_BYTES=8388608
ARDA_RETENTION_DAYS_WARDEN_PERMISSION_AUDIT=14
ARDA_WARDEN_PERMISSION_AUDIT_MAX_KEEP=12000
ARDA_WARDEN_PERMISSION_AUDIT_MAX_BYTES=6291456

# Pressure-coupled admission. Shared bounded gates will automatically tighten under
# Joule, disk, memory, and swap pressure using sovereign runtime surfaces.
ARDA_PRESSURE_ADMISSION_ENABLED=true
ARDA_PRESSURE_ADMISSION_CACHE_MS=1000
ARDA_PRESSURE_ADMISSION_DEGRADED_FACTOR=0.5
ARDA_PRESSURE_ADMISSION_SEVERE_FACTOR=0.25
ARDA_PRESSURE_ADMISSION_MEM_AVAILABLE_DEGRADED_PCT=10
ARDA_PRESSURE_ADMISSION_MEM_AVAILABLE_SEVERE_PCT=5
ARDA_PRESSURE_ADMISSION_RECEIPTS_PATH=data/prometheus/runtime_admission_shed_receipts.jsonl
ARDA_PRESSURE_ADMISSION_RECOVERY_PATH=core/state/runtime_admission_recovery.json

# Heavy runtime work admission caps.
# These bound overlapping ingest, queue draining, outbound retry, and sweep work inside the crates.
ARDA_ATHENA_INGEST_MAX_CONCURRENCY=2
ARDA_ATHENA_DEEP_QUEUE_MAX_CONCURRENCY=1
ARDA_ATHENA_CRAWL_MAX_CONCURRENCY=1
ARDA_ATHENA_IPC_MAX_CONCURRENCY=16
ARDA_ATHENA_HTTP_MAX_CONCURRENCY=24
ARDA_PROMETHEUS_IPC_MAX_CONCURRENCY=16
ARDA_PROMETHEUS_HTTP_MAX_CONCURRENCY=24
ARDA_CHARON_IPC_MAX_CONCURRENCY=16
ARDA_CHARON_HTTP_MAX_CONCURRENCY=24
ARDA_HERMES_SEND_MAX_CONCURRENCY=2
ARDA_HERMES_POLL_MAX_CONCURRENCY=1
ARDA_HERMES_OUTBOUND_RETRY_MAX_CONCURRENCY=1
ARDA_HERMES_PROVIDER_DISPATCH_MAX_CONCURRENCY=2
ARDA_HERMES_PROVIDER_POLL_MAX_CONCURRENCY=1
ARDA_HERMES_IPC_MAX_CONCURRENCY=16
ARDA_HERMES_HTTP_MAX_CONCURRENCY=24
ARDA_HERMES_DISCORD_ACTIVITY_PANEL=true

# Optional Discord channel alias map. If set, Hermes can route logical recipients
# like boardroom, ops-boardroom, client-bridge, research-forge, and governance-audit
# to distinct Discord channel IDs instead of collapsing all sends to DISCORD_CHANNEL_ID.
# DISCORD_CHANNEL_ID remains the default fallback channel.
# DISCORD_CHANNEL_BOARDROOM=
# DISCORD_CHANNEL_OPS_BOARDROOM=
# DISCORD_CHANNEL_CEO_BOARDROOM=
# DISCORD_CHANNEL_CLIENT_BRIDGE=
# DISCORD_CHANNEL_RESEARCH_FORGE=
# DISCORD_CHANNEL_GOVERNANCE_AUDIT=
ARDA_HADES_SWEEP_MAX_CONCURRENCY=1
ARDA_HADES_REMOVAL_STEP_MAX_CONCURRENCY=1
ARDA_HADES_IPC_MAX_CONCURRENCY=16
ARDA_HADES_HTTP_MAX_CONCURRENCY=16
ARDA_APOLLO_IPC_MAX_CONCURRENCY=16
ARDA_APOLLO_HTTP_MAX_CONCURRENCY=16
ARDA_ORACLE_IPC_MAX_CONCURRENCY=16
ARDA_ORACLE_HTTP_MAX_CONCURRENCY=16
ARDA_PLUTUS_IPC_MAX_CONCURRENCY=16
ARDA_PLUTUS_HTTP_MAX_CONCURRENCY=16
ARDA_MNEMOSYNE_IPC_MAX_CONCURRENCY=16
ARDA_MNEMOSYNE_HTTP_MAX_CONCURRENCY=16

# Launch preflight reads sovereign governance + pressure surfaces before local starts.
# When degraded, only bounded control-plane agents are allowed to spawn by default.
ARDA_LAUNCH_PREFLIGHT_DEGRADED_AGENTS=prometheus,charon,hermes
ARDA_LAUNCH_PREFLIGHT_ENFORCE_SWAP=true

# Fleet command tower overrides (optional)
ARDA_FLEET_CONFIG_PATH=config/fleet.toml
ARDA_FLEET_ENABLED=true
ARDA_FLEET_STATUS_VIEW_MODE=active_only
ARDA_FLEET_STALE_DAYS=14
ARDA_FLEET_INCLUDE_RECENT_OFFLINE_IN_STATUS=false
ARDA_FLEET_BOOTSTRAP_STATE=core/state/fleet_bootstrap.json
ARDA_FLEET_BOOTSTRAP_RECOVER=true
ARDA_FLEET_BOOTSTRAP_RECOVER_WAIT_SECONDS=8
ARDA_FLEET_BOOTSTRAP_RECOVER_RETRIES=1
ARDA_FLEET_BOOTSTRAP_SSH_TIMEOUT_SECONDS=20
ARDA_ROUTE_ORIGIN_DEFAULT=auto
ARDA_LOCAL_INFERENCE_SURFACE=mesh
ARDA_FLEET_PROMETHEUS_DIR=data/prometheus
ARDA_FLEET_CEO_LAYER_PROMETHEUS_DIR=core/metrics/by_crate/prometheus
ARDA_FLEET_WARDEN_QUEUE_PATH=data/warden/informant_queue.jsonl

# Local fallback model used by CHARON local_fallback provider
ARDA_LOCAL_MODEL=qwen2.5-coder:3b
ARDA_ATHENA_CRAWL_PROFILE=production
ARDA_ATHENA_CRAWL_PROVIDER=crawl4ai,scrapling
ARDA_SCRAPLING_RUNTIME_MODE=shim_allowed
LITELLM_PROXY_HOST=127.0.0.1
LITELLM_PROXY_PORT=4000
LITELLM_PROXY_URL=http://${LITELLM_PROXY_HOST}:${LITELLM_PROXY_PORT}/v1
ARDA_CRAWL4AI_HOST=127.0.0.1
ARDA_CRAWL4AI_PORT=11235
ARDA_CRAWL4AI_URL=http://${ARDA_CRAWL4AI_HOST}:${ARDA_CRAWL4AI_PORT}
ARDA_SEARCH_RUNTIME_URL=http://${ARDA_SEARCH_RUNTIME_HOST}:${ARDA_SEARCH_RUNTIME_PORT}
ARDA_SEARCH_RUNTIME_HOST=127.0.0.1
ARDA_SEARCH_RUNTIME_PORT=18080
ARDA_SEARCH_RUNTIME_IMAGE=docker.io/searxng/searxng:latest
ARDA_SEARCH_RUNTIME_CONTAINER_NAME=ARDA-searxng
ARDA_PLAYWRIGHT_MCP_CMD="npx @playwright/mcp@latest --stdio"
ARDA_NANOCLAW_ROOT=
ARDA_NANOCLAW_EDGE_TARGET=node-pi5-warden
ARDA_NANOCLAW_EDGE_TRANSPORT=tailscale
ARDA_NANOCLAW_CONTROL_MODE=headless

# PROMETHEUS machine thought ledger root
ARDA_PROMETHEUS_MINDS=~/.citadel/minds/machine
