[Unit]
Description=Crawl4AI markdown service for Arda governed research
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/docker start --attach crawl4ai
ExecStop=/usr/bin/docker stop --time 15 crawl4ai
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
