[Unit]
Description=Arda Prometheus Metrics Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/home/mythos/Eregion/Arda
Environment=ARDA_ROOT=/var/home/mythos/Eregion/Arda
ExecStart=/var/home/mythos/.local/bin/arda-cli metrics serve --root /var/home/mythos/Eregion/Arda --bind 0.0.0.0 --port 9101 --refresh-secs 15
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
