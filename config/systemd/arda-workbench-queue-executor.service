[Unit]
Description=Arda bounded Workbench canonical queue executor
Documentation=file:///var/home/mythos/Eregion/Arda/docs/architecture/AGENT_EVIDENCE_BOOTSTRAP.md
After=arda.service
Requires=arda.service
ConditionPathExists=%h/Eregion/Arda/core/projects/tasks/queue.jsonl

[Service]
Type=oneshot
WorkingDirectory=%h/Eregion/Arda
Environment=ARDA_ROOT=%h/Eregion/Arda
Environment=ARDA_HARNESS_URL=http://127.0.0.1:7878
Environment=ARDA_PROJECT_TASK_QUEUE_PATH=core/projects/tasks/queue.jsonl
Environment=ARDA_HERMES_ADAPTER_CONFIG=%h/Eregion/Arda/config/adapters/hermes-workbench.toml
Environment=ARDA_WORKER_LIMITS_CONFIG=%h/Eregion/Arda/config/runtime/worker_orchestration.toml
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/arda-cli prometheus autopilot execute-approved-task --root %h/Eregion/Arda
TimeoutStartSec=25min
Nice=10

# Keep this adapter local and bounded. Workbench owns worker admission,
# cancellation, execution receipts, and run transitions.
NoNewPrivileges=true
PrivateTmp=true
