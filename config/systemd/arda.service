[Unit]
Description=Arda local harness tap-in surface
After=network-online.target arda-manwe.service
Wants=network-online.target arda-manwe.service

[Service]
Type=simple
WorkingDirectory=%h/Eregion/Arda
Environment=RUST_LOG=info
Environment=ARDA_ROOT=%h/Eregion/Arda
ExecStart=%h/.local/bin/arda --harness-only
Restart=always
RestartSec=3

[Install]
WantedBy=default.target