[Unit]
Description=Arda canonical root runtime supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Eregion/Arda
EnvironmentFile=%h/Eregion/Arda/config/.env
Environment=RUST_LOG=info
Environment=ARDA_ROOT=%h/Eregion/Arda
Environment=ARDA_MANWE_PROVIDER_CONFIG=%h/Eregion/Arda/config/manwe.providers.toml
Environment=ARDA_OPERATOR_ID=operator:mythos
Environment=ARDA_PROMETHEUS_URL=http://100.103.125.88:9090
Environment=ARDA_OTLP_ENDPOINT=http://100.103.125.88:3001/api/public/otel/v1/traces
Environment=ARDA_OTLP_PROTOCOL=http/protobuf
Environment=OTEL_SERVICE_NAME=arda
LoadCredential=langfuse-otlp-authorization:%h/.local/share/arda/credentials/langfuse-otlp-authorization
LoadCredential=arda-hermes-gateway-capability:%h/.config/arda/credentials/hermes-gateway-capability
LoadCredential=arda-manwe-mutation:%h/.config/arda/credentials/hermes-gateway-capability
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/arda --no-ui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
Alias=arda-manwe.service