{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arda.local/spec/personal-ops/v1/personal-ops.schema.json",
  "title": "Arda Personal Operations v1",
  "type": "object",
  "required": ["schema_version", "record"],
  "properties": {
    "schema_version": { "const": "arda.personal-ops.v1" },
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/inboxCapture" },
        { "$ref": "#/$defs/personalItem" },
        { "$ref": "#/$defs/reminderReceipt" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceClass": {
      "enum": [
        "operator_authored",
        "imported",
        "inferred",
        "device_measured",
        "self_reported",
        "unavailable"
      ]
    },
    "captureContent": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "audio_reference": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["audio_reference"] }
      ],
      "additionalProperties": false
    },
    "captureAttachment": {
      "type": "object",
      "required": ["attachment_id", "media_type", "reference"],
      "properties": {
        "attachment_id": { "$ref": "#/$defs/uuid" },
        "media_type": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "inboxCapture": {
      "type": "object",
      "required": ["capture_id", "captured_at", "source", "content"],
      "properties": {
        "capture_id": { "$ref": "#/$defs/uuid" },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "source": { "enum": ["text", "audio", "import", "device"] },
        "content": { "$ref": "#/$defs/captureContent" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/captureAttachment" },
          "default": []
        },
        "project_id": { "$ref": "#/$defs/uuid" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 255 },
        "due_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "classifiedKind": {
      "type": "object",
      "required": ["value", "evidence_class"],
      "properties": {
        "value": {
          "enum": ["note", "task", "reminder", "appointment", "contact", "health"]
        },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contextLink": {
      "type": "object",
      "required": ["relation", "target_id", "evidence_class"],
      "properties": {
        "relation": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      },
      "additionalProperties": false
    },
    "personalItem": {
      "type": "object",
      "required": ["item_id", "source_capture_id", "created_at", "content", "kind"],
      "properties": {
        "item_id": { "$ref": "#/$defs/uuid" },
        "source_capture_id": { "$ref": "#/$defs/uuid" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "content": { "$ref": "#/$defs/captureContent" },
        "kind": { "$ref": "#/$defs/classifiedKind" },
        "context_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextLink" },
          "default": []
        },
        "non_clinical_disclosure": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "properties": { "value": { "const": "health" } },
                "required": ["value"]
              }
            },
            "required": ["kind"]
          },
          "then": { "required": ["non_clinical_disclosure"] }
        }
      ],
      "additionalProperties": false
    },
    "quietWindow": {
      "type": "object",
      "required": ["start_local", "end_local", "timezone"],
      "properties": {
        "start_local": { "type": "string", "minLength": 1 },
        "end_local": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reminderPolicy": {
      "type": "object",
      "required": [
        "interruption",
        "max_attempts",
        "minimum_interval_minutes",
        "acknowledgement_required"
      ],
      "properties": {
        "interruption": {
          "enum": ["silent", "quiet_window_aware", "operator_confirmed"]
        },
        "quiet_window": { "$ref": "#/$defs/quietWindow" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "minimum_interval_minutes": { "type": "integer", "minimum": 1 },
        "acknowledgement_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reminderReceipt": {
      "type": "object",
      "required": ["reminder_id", "item_id", "attempted_at", "state", "channel"],
      "properties": {
        "reminder_id": { "$ref": "#/$defs/uuid" },
        "item_id": { "$ref": "#/$defs/uuid" },
        "attempted_at": { "$ref": "#/$defs/timestamp" },
        "state": {
          "enum": ["attempted", "delivered", "acknowledged", "deferred", "dismissed", "failed"]
        },
        "channel": { "type": "string", "minLength": 1 },
        "receipt_reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
